---
import Base from '../layouts/Base.astro';
import Silhouette from '../components/Silhouette.astro';
import Drop from '../components/Drop.astro';
import { SITE, PAGES, GROUPS, GROUP_ID } from '../site';
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: PAGES.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.h1, url: new URL(`/${p.slug}/`, SITE.url).href })),
  },
];
---
<Base
  title="Stayfile: PDF, image and CSV tools that never upload your files"
  description="PDF, image and data tools that run in your browser. Merge and split PDFs, convert images, and convert CSV, JSON and Markdown tables. Your files never leave your device."
  path="/"
  jsonld={jsonld}
>
  <div class="board bleed home">
    <div class="wall">
      <h1>File tools that keep your files on your device</h1>
      <p class="lede">Each tool here runs inside your browser tab. The files you open are read and changed on your own computer, and none of them is uploaded.</p>
      <section class="tool start" data-family="any" aria-label="Start with your files">
        <Drop accept=".pdf,image/*,.heic,.heif,.csv,.tsv,.json,.jsonl,.ndjson,.yaml,.yml,.xlsx,.txt,.md,.markdown,.log,.ico" multiple take={false} main="Drop files here, or <u>choose files</u>" sub="PDF · images · iPhone photos · CSV · JSON · YAML · Excel · text. You pick what to do next." />
        <div class="routes" id="routes" hidden>
          <p class="routes-line" id="routesLine" aria-live="polite"></p>
          <div class="routes-row" id="routesRow"></div>
          <button type="button" class="link" id="routesReset">Choose other files</button>
        </div>
      </section>
      <p class="or">Or pick a tool</p>
      <div class="zones">
        {GROUPS.map((g) => (
          <section class="zone" id={GROUP_ID[g]} aria-labelledby={`g-${GROUP_ID[g]}`}>
            <h2 id={`g-${GROUP_ID[g]}`} class="tape">{g}</h2>
            <ul class="hooks">
              {PAGES.filter((p) => p.group === g).map((p) => (
                <li>
                  <a class="hook" href={`/${p.slug}/`}>
                    <Silhouette slug={p.slug} />
                    <span class="t">{p.card}</span>
                    <span class="sr">{p.blurb}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </div>
  <section class="row how">
    <h2>How can it work without uploading?</h2>
    <div>
      <figure class="trip" aria-hidden="true">
        <svg viewBox="0 0 560 120">
          <g class="leg"><path class="body" d="M24 22h40l14 14v62H24z" /><path class="cut" d="M64 22v14h14M36 56h30M36 68h30M36 80h18" /></g>
          <path class="wire" d="M100 60h70" /><path class="head" d="M164 52l10 8l-10 8" />
          <g class="leg"><rect class="body" x="196" y="20" width="168" height="80" rx="6" /><path class="cut" d="M196 38h168M212 29h1M222 29h1M232 29h1" /><path class="body tagged" d="M254 52h52v36h-52z" /></g>
          <path class="wire" d="M386 60h70" /><path class="head" d="M450 52l10 8l-10 8" />
          <g class="leg"><path class="body" d="M482 22h40l14 14v62h-54z" /><path class="cut" d="M522 22v14h14M509 50v30M497 68l12 12l12 -12" /></g>
        </svg>
        <figcaption><span>Your file</span><span>This tab</span><span>Your download</span></figcaption>
      </figure>
      <p class="prose">Your browser can already read files and run code, so the page brings the code to your file instead of sending your file to a server. When you open a PDF here, it is read into memory in this tab, changed there, and handed back to you as a download. Close the tab and it is gone. You can check this yourself: open your browser's developer tools, switch to the Network tab and watch while you use a tool. No file goes out.</p>
    </div>
  </section>
</Base>
<script>
  import { suggestTools, describeDrop } from '../lib/route';
  import { handOff } from '../lib/handoff';
  const drop = document.getElementById('drop')!;
  const routes = document.getElementById('routes')!;
  const row = document.getElementById('routesRow')!;
  const line = document.getElementById('routesLine')!;
  let held: File[] = [];
  function show(files: File[]) {
    held = files;
    const opts = suggestTools(files);
    row.innerHTML = '';
    if (!opts.length) {
      line.textContent = 'No single tool here takes all of these together. Try one kind of file at a time.';
    } else if (opts.length === 1) {
      // Only one thing to do, so do it.
      line.textContent = `Opening ${opts[0].label.toLowerCase()}…`;
      handOff(files, opts[0].slug);
    } else {
      line.textContent = describeDrop(files);
      for (const [i, r] of opts.entries()) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = i === 0 ? 'primary' : 'chip';
        b.textContent = r.label;
        b.onclick = () => { b.disabled = true; handOff(held, r.slug); };
        row.append(b);
      }
    }
    routes.hidden = false;
    drop.classList.add('compact');
    row.querySelector<HTMLButtonElement>('button')?.focus();
  }
  drop.addEventListener('files', (e) => show((e as CustomEvent<File[]>).detail));
  document.getElementById('routesReset')!.addEventListener('click', () => {
    held = []; routes.hidden = true; drop.classList.remove('compact');
    (document.getElementById('file') as HTMLInputElement).click();
  });
</script>
<style>
  .start { margin: 0 0 12px; }
  .routes { padding-top: 16px; display: grid; gap: 12px; justify-items: start; }
  .routes-line { margin: 0; font-weight: 700; }
  .routes-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .routes .link { height: 36px; padding: 0; }
  .or { margin: 28px 0 16px; font-weight: 700; font-stretch: 108%; color: var(--paint-muted); }
  .home { padding-bottom: 56px; }
  .zones { display: grid; gap: 28px; }
  .zone { display: grid; grid-template-columns: 168px minmax(0, 1fr); gap: 16px 24px; align-items: start; }
  .zone > h2 { justify-self: start; font-size: 14px; margin: 18px 0 0; }
  .hooks { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(132px, 1fr)); gap: 12px 16px; }
  .hooks li:first-child { grid-column: span 2; grid-row: span 2; }
  @media (min-width: 1000px) { .hooks { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  .hook { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 14px 8px 12px; color: var(--paint); text-decoration: none; border-radius: var(--r); transition: opacity .16s cubic-bezier(.2, 0, .2, 1), background-color .16s; height: 100%; }
  .hook::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--peg); box-shadow: 0 2px 0 rgba(0, 0, 0, 0.35); flex: none; }
  .hook .sil { width: 100%; max-width: 132px; }
  li:first-child > .hook .sil { max-width: 260px; }
  .hook .t { font-weight: 700; font-stretch: 110%; font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; line-height: 1; padding: 6px 8px 5px; border-radius: 3px; background: var(--tape); color: var(--on-tape); text-align: center; }
  li:first-child > .hook .t { font-size: 15px; }
  .hook:hover, .hook:focus-visible { color: #ffffff; background: rgba(0, 0, 0, 0.16); }
  .hook:hover .t, .hook:focus-visible .t { background: var(--tag); color: var(--on-tag); }
  .zones:has(.hook:hover) .hook:not(:hover) { opacity: .55; }

  .trip { margin: 0 0 20px; max-width: 560px; }
  .trip svg { display: block; width: 100%; }
  .trip .body { fill: var(--link); }
  .trip .tagged { fill: var(--tag); }
  .trip .cut { fill: none; stroke: var(--ground); stroke-width: 3; stroke-linecap: round; }
  .trip .wire { stroke: var(--line-strong); stroke-width: 3; stroke-dasharray: 2 7; stroke-linecap: round; }
  .trip .head { fill: none; stroke: var(--line-strong); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .trip figcaption { display: grid; grid-template-columns: 102fr 70fr 168fr 70fr 150fr; font-size: 13px; font-weight: 700; color: var(--muted); margin-top: 6px; }
  .trip figcaption span:nth-child(1) { grid-column: 1; }
  .trip figcaption span:nth-child(2) { grid-column: 3; text-align: center; }
  .trip figcaption span:nth-child(3) { grid-column: 5; text-align: right; }
  .prose { max-width: 66ch; color: var(--muted); margin: 0; }
  .how { margin-top: 24px; border-top: 0; }

  @media (max-width: 760px) {
    .zone { grid-template-columns: 1fr; }
    .zone > h2 { margin-top: 0; }
    .hooks { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; }
    .hooks li:first-child { grid-column: span 3; grid-row: auto; }
    li:first-child > .hook .sil { max-width: 150px; }
    .hook { padding: 10px 2px; }
    .hook .t { font-size: 11px; padding: 5px 6px 4px; }
    li:first-child > .hook .t { font-size: 13px; }
  }
</style>
