---
import Drop from './Drop.astro';
import type { Tool, Preset } from '../site';
interface Props { tool: Tool; slug: string; preset?: Preset }
const { tool, slug, preset } = Astro.props;
const fromJson = tool === 'json-to-csv' || tool === 'json-to-xlsx' || tool === 'json-to-markdown';
const fromXlsx = tool === 'xlsx-to-csv' || tool === 'xlsx-to-json' || tool === 'xlsx-to-markdown' || tool === 'xlsx-to-tsv';
const fromTsv = tool === 'tsv-to-csv';
const fromCsvTsv = tool === 'csv-to-tsv';
const fromYaml = tool === 'yaml-to-json' || tool === 'json-to-yaml';
const fromMd = tool === 'md-to-csv' || tool === 'md-to-json' || tool === 'md-to-xlsx';
const pExts = (preset?.accept ?? '').match(/\.[a-z0-9]+/gi)?.map((e) => e.slice(1).toUpperCase()) ?? [];
const presetLabel = pExts.join(' · ');
const isTsv = pExts.includes('TSV');
const isJsonl = pExts.includes('JSONL') || pExts.includes('NDJSON');
const accept = preset?.accept ?? (fromXlsx
  ? '.xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
  : fromMd ? '.md,.markdown,text/markdown,text/plain'
  : tool === 'yaml-to-json' ? '.yaml,.yml,application/yaml,application/x-yaml,text/yaml,text/plain'
  : tool === 'json-to-yaml' ? '.json,application/json,text/plain'
  : fromJson ? '.json,.jsonl,.ndjson,application/json,text/plain' : fromTsv ? '.tsv,text/tab-separated-values,text/plain' : '.csv,.tsv,.txt,text/csv,text/plain');
const what = fromYaml ? (tool === 'yaml-to-json' ? 'a YAML file' : 'a JSON file') : fromMd ? 'a Markdown file' : isTsv || fromTsv ? 'a .tsv file' : isJsonl ? 'a .jsonl file' : fromXlsx ? 'an Excel file' : fromJson ? 'a JSON file' : 'a CSV file';
const placeholder = fromYaml
  ? tool === 'yaml-to-json' ? 'name: Ada\nage: 36\ncity: London' : '{"name": "Ada", "age": 36}'
  : fromMd
  ? '| name | age |\n| --- | --- |\n| Ada | 36 |\n| Grace | 85 |'
  : fromTsv || isTsv
    ? 'name\tage\nAda\t36\nGrace\t85'
    : isJsonl
      ? '{"name": "Ada", "age": 36}\n{"name": "Grace", "age": 85}'
      : fromJson ? '[{"name": "Ada", "age": 36}, {"name": "Grace", "age": 85}]' : 'name,age\nAda,36\nGrace,85';
const sub = presetLabel ? `${presetLabel} files, or paste below` : fromYaml ? 'or paste below' : fromXlsx ? 'Only the first sheet is converted' : fromMd ? 'A Markdown table, or paste below' : fromTsv ? 'TSV files, or paste below' : fromCsvTsv ? 'CSV files, or paste below' : 'or paste below';
const outLabel = { 'yaml-to-json': 'Download .json', 'json-to-yaml': 'Download .yaml', 'csv-to-json': 'Download .json', 'json-to-csv': 'Download .csv', 'csv-to-xlsx': 'Download .xlsx', 'xlsx-to-csv': 'Download .csv', 'xlsx-to-json': 'Download .json', 'xlsx-to-markdown': 'Download .md', 'json-to-markdown': 'Download .md', 'json-to-xlsx': 'Download .xlsx', 'csv-to-markdown': 'Download .md', 'tsv-to-csv': 'Download .csv', 'csv-to-tsv': 'Download .tsv', 'xlsx-to-tsv': 'Download .tsv', 'md-to-csv': 'Download .csv', 'md-to-json': 'Download .json', 'md-to-xlsx': 'Download .xlsx' }[tool as string];
---
<section class="tool" data-tool={tool} data-slug={slug}>
  <Drop accept={accept} main={`Drop ${what} here, or <u>choose one</u>`} sub={sub} />
  <ul class="files" id="list"></ul>
  <div id="pasteWrap" hidden={fromXlsx}>
    <label class="hint" for="input" style="display:block;margin:12px 0 6px">Or paste {fromYaml ? (tool === 'yaml-to-json' ? 'YAML' : 'JSON') : fromJson ? 'JSON' : fromTsv ? 'TSV' : fromMd ? 'Markdown' : 'CSV'}</label>
    <textarea id="input" rows="6" spellcheck="false" placeholder={placeholder}></textarea>
  </div>
  <button type="button" class="link" id="showText" hidden>Edit the text</button>

  <div class="opts">
    {!fromJson && !fromXlsx && !fromTsv && !fromCsvTsv && !fromMd && !fromYaml && (
      <>
        <label>Separator
          <select id="delim">
            <option value="">Detect</option>
            <option value=",">Comma ,</option>
            <option value=";">Semicolon ;</option>
            <option value="&#9;">Tab</option>
            <option value="|">Pipe |</option>
          </select>
        </label>
        <label class="check"><input type="checkbox" id="header" checked /> First row is column names</label>
        <label class="check"><input type="checkbox" id="text" /> Keep all values as text</label>
      </>
    )}
    {fromJson && tool !== 'json-to-markdown' && (
      <label>Separator
        <select id="delim">
          <option value=",">Comma ,</option>
          <option value=";">Semicolon ; (Excel in much of Europe)</option>
          <option value="&#9;">Tab</option>
        </select>
      </label>
    )}
  </div>

  <div class="actions">
    <button type="button" class="primary" id="go" disabled>{outLabel}</button>
    {tool !== 'csv-to-xlsx' && tool !== 'json-to-xlsx' && tool !== 'md-to-xlsx' && <button type="button" class="secondary" id="copy" disabled>Copy</button>}
    <span class="status" id="status" aria-live="polite"></span>
  </div>
  <div class="done" id="done" role="status" hidden></div>
  <p class="error" id="err" role="alert" hidden></p>

  <div class="preview" id="tableWrap" hidden><table><thead id="thead"></thead><tbody id="tbody"></tbody></table></div>
  {(tool === 'csv-to-json' || tool === 'xlsx-to-json' || tool === 'csv-to-markdown' || tool === 'xlsx-to-markdown' || tool === 'xlsx-to-tsv' || tool === 'json-to-markdown' || tool === 'md-to-json' || tool === 'yaml-to-json' || tool === 'json-to-yaml') && <textarea id="output" rows="12" readonly spellcheck="false" aria-label="Output" hidden style="margin-top:14px"></textarea>}
</section>

<script>
  import { parseCsv, csvToJson, csvToMarkdown, tsvToCsv, csvToTsv, markdownToCsv, markdownToJson, markdownTableRows, jsonRows, columns, jsonToCsv, jsonToMarkdown, type CsvOptions } from '../lib/data';
  import { save, baseName } from '../lib/save';
  import { savedLine } from '../lib/route';
  import { showDone, hideDone } from '../lib/done';

  const root = document.querySelector<HTMLElement>('.tool')!;
  const tool = root.dataset.tool!;
  const fromXlsx = tool === 'xlsx-to-csv' || tool === 'xlsx-to-json' || tool === 'xlsx-to-markdown' || tool === 'xlsx-to-tsv';
  const fromTsv = tool === 'tsv-to-csv';
  const fromCsvTsv = tool === 'csv-to-tsv';
  const fromMd = tool === 'md-to-csv' || tool === 'md-to-json' || tool === 'md-to-xlsx';
  const fromYaml = tool === 'yaml-to-json' || tool === 'json-to-yaml';
  // js-yaml loads only on the two YAML pages, never on the rest of the data tools.
  let yamlMod: Promise<typeof import('../lib/yaml')> | null = null;
  const loadYaml = () => (yamlMod ??= import('../lib/yaml'));
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const input = $<HTMLTextAreaElement>('input')!, drop = $('drop')!, go = $<HTMLButtonElement>('go')!, copy = $<HTMLButtonElement>('copy');
  const status = $('status')!, err = $('err')!, list = $('list')!, out = $<HTMLTextAreaElement>('output');
  const MAX_ROWS = 50;
  let name = 'data';
  let result = '';
  let sheetInfo = ''; // Excel only: says how many sheets were left out

  const opts = (): CsvOptions => ({
    delimiter: $<HTMLSelectElement>('delim')!.value,
    header: $<HTMLInputElement>('header')?.checked ?? true,
    typed: !($<HTMLInputElement>('text')?.checked ?? false),
  });

  function table(head: string[], rows: unknown[][]) {
    const th = $('thead')!, tb = $('tbody')!;
    th.innerHTML = ''; tb.innerHTML = '';
    if (head.length) {
      const tr = document.createElement('tr');
      for (const h of head) { const c = document.createElement('th'); c.textContent = h; tr.append(c); }
      th.append(tr);
    }
    for (const r of rows.slice(0, MAX_ROWS)) {
      const tr = document.createElement('tr');
      for (const v of r) { const c = document.createElement('td'); c.textContent = v == null ? '' : String(v); c.title = c.textContent; tr.append(c); }
      tb.append(tr);
    }
    $('tableWrap')!.hidden = !rows.length;
  }

  async function update() {
    err.hidden = true;
    hideDone($('done'));
    const text = input.value;
    result = '';
    go.disabled = true;
    if (copy) copy.disabled = true;
    if (!text.trim()) { status.textContent = ''; table([], []); if (out) out.hidden = true; return; }
    try {
      if (tool === 'json-to-csv' || tool === 'json-to-xlsx' || tool === 'json-to-markdown') {
        const rows = jsonRows(text);
        const cols = columns(rows);
        result = tool === 'json-to-markdown' ? jsonToMarkdown(text) : jsonToCsv(text, { delimiter: $<HTMLSelectElement>('delim')!.value });
        if (tool === 'json-to-markdown') {
          out!.value = result.length > 200_000 ? result.slice(0, 200_000) + '\n… (preview cut short; the download has everything)' : result;
          out!.hidden = false;
        }
        table(cols, rows.map((r) => cols.map((c) => r[c])));
        status.textContent = `${rows.length} row${rows.length === 1 ? '' : 's'}, ${cols.length} column${cols.length === 1 ? '' : 's'}${rows.length > MAX_ROWS ? `. Preview shows the first ${MAX_ROWS}.` : '.'}`;
      } else if (fromTsv || fromCsvTsv) {
        // One delimiter in, the other out. No options: the delimiter is the point of the page.
        const p = fromTsv
          ? parseCsv(text, { delimiter: '\t', header: false, typed: false })
          : parseCsv(text, { delimiter: '', header: false, typed: false }); // auto-detect
        const rows = p.rows as unknown[][];
        const cols = rows.reduce((m, r) => Math.max(m, r.length), 0);
        result = fromTsv ? tsvToCsv(text) : csvToTsv(text);
        table([], rows);
        status.textContent = `${rows.length} row${rows.length === 1 ? '' : 's'}, ${cols} column${cols === 1 ? '' : 's'}, saved as ${fromTsv ? 'comma' : 'tab'}-separated values.${rows.length > MAX_ROWS ? ` Preview shows the first ${MAX_ROWS}.` : ''}`;
        if (p.warnings.length) { err.textContent = `Check these rows: ${p.warnings.join(' · ')}`; err.hidden = false; }
      } else if (fromYaml) {
        const { yamlToJson, jsonToYaml } = await loadYaml();
        const toJson = tool === 'yaml-to-json';
        result = toJson ? yamlToJson(text) : jsonToYaml(text);
        out!.value = result.length > 200_000 ? result.slice(0, 200_000) + '\n… (preview cut short; the download has everything)' : result;
        out!.hidden = false;
        const rows = jsonRows(toJson ? result : text);
        const cols = columns(rows);
        table(cols, rows.map((r) => cols.map((c) => r[c])));
        status.textContent = `${rows.length} row${rows.length === 1 ? '' : 's'}, ${cols.length} column${cols.length === 1 ? '' : 's'}, ${toJson ? 'typed as numbers where possible' : 'dumped as YAML'}.${rows.length > MAX_ROWS ? ` Preview shows the first ${MAX_ROWS}.` : ''}`;
      } else if (fromMd) {
        // The first Markdown table in the text becomes rows; the first row is the header.
        const rows = markdownTableRows(text);
        const cols = rows.reduce((m, r) => Math.max(m, r.length), 0);
        const toJson = tool === 'md-to-json';
        result = toJson ? markdownToJson(text) : markdownToCsv(text);
        if (toJson) { out!.value = result.length > 200_000 ? result.slice(0, 200_000) + '\n… (preview cut short; the download has everything)' : result; out!.hidden = false; }
        table(rows[0] ?? [], rows.slice(1));
        status.textContent = `${rows.length - 1} row${rows.length - 1 === 1 ? '' : 's'}, ${cols} column${cols === 1 ? '' : 's'}, first row used as the header${toJson ? ', typed as numbers where possible' : ''}.${rows.length - 1 > MAX_ROWS ? ` Preview shows the first ${MAX_ROWS}.` : ''}`;
      } else if (fromXlsx) {
        // The text is the first sheet already converted to CSV. CSV downloads are the text itself; JSON is built from it.
        const rows = parseCsv(text, { delimiter: ',', header: false, typed: false }).rows as unknown[][];
        const cols = rows.reduce((m, r) => Math.max(m, r.length), 0);
        const json = tool === 'xlsx-to-json';
        const md = tool === 'xlsx-to-markdown';
        const tsv = tool === 'xlsx-to-tsv';
        if (json || md || tsv) {
          result = tsv ? csvToTsv(text) : md ? csvToMarkdown(text, { delimiter: ',', header: true }) : csvToJson(text, { delimiter: ',', header: true, typed: true });
          out!.value = result.length > 200_000 ? result.slice(0, 200_000) + '\n… (preview cut short; the download has everything)' : result;
          out!.hidden = false;
          table(rows[0]?.map((h) => String(h ?? '')) ?? [], rows.slice(1));
        } else {
          result = text;
          table([], rows);
        }
        const shape = json ? 'first row used as keys' : md ? 'as a Markdown table' : tsv ? 'as tab-separated values' : 'comma-separated';
        status.textContent = `${rows.length} row${rows.length === 1 ? '' : 's'}, ${cols} column${cols === 1 ? '' : 's'}, ${shape}.${sheetInfo ? ` ${sheetInfo}` : ''}${rows.length > MAX_ROWS ? ` Preview shows the first ${MAX_ROWS}.` : ''}`;
      } else {
        const o = opts();
        const p = parseCsv(text, o);
        const head = o.header ? p.fields : [];
        const rows = o.header ? (p.rows as Record<string, unknown>[]).map((r) => head.map((h) => r[h])) : (p.rows as unknown[][]);
        table(head, rows);
        if (tool === 'csv-to-json' || tool === 'csv-to-markdown') {
          result = tool === 'csv-to-json' ? csvToJson(text, o) : csvToMarkdown(text, o);
          out!.value = result.length > 200_000 ? result.slice(0, 200_000) + '\n… (preview cut short; the download has everything)' : result;
          out!.hidden = false;
        } else result = 'xlsx';
        const sep = { ',': 'comma', ';': 'semicolon', '\t': 'tab', '|': 'pipe' }[p.delimiter] ?? `"${p.delimiter}"`;
        status.textContent = `${rows.length} row${rows.length === 1 ? '' : 's'}, ${o.header ? `${head.length} columns, ` : ''}${sep}-separated${rows.length > MAX_ROWS ? `. Preview shows the first ${MAX_ROWS}.` : '.'}`;
        if (p.warnings.length) { err.textContent = `Check these rows: ${p.warnings.join(' · ')}`; err.hidden = false; }
      }
      go.disabled = false;
      if (copy) copy.disabled = false;
    } catch (e) {
      table([], []);
      if (out) out.hidden = true;
      status.textContent = '';
      err.textContent = (e as Error).message;
      err.hidden = false;
    }
  }

  let timer = 0;
  input.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(update, 250); });
  root.querySelectorAll('select, input[type=checkbox]').forEach((el) => el.addEventListener('change', update));

  drop.addEventListener('files', async (e) => {
    const all = (e as CustomEvent<File[]>).detail;
    const f = all[0];
    const looksData = /^text\//.test(f.type) || f.type === '' || f.type === 'application/json' || f.type === 'application/yaml' || f.type === 'application/x-yaml' || f.type === 'application/vnd.ms-excel' || /\.(csv|tsv|txt|json|jsonl|ndjson|yaml|yml)$/i.test(f.name);
    if (!fromXlsx && !fromMd && !looksData) {
      list.innerHTML = '';
      err.textContent = `${f.name} does not look like ${fromYaml ? (tool === 'yaml-to-json' ? 'a YAML or JSON' : 'a JSON') : fromJson ? 'a JSON' : fromTsv ? 'a TSV' : fromMd ? 'a Markdown' : 'a CSV'} file.`;
      err.hidden = false;
      return;
    }
    if (fromTsv && /\.csv$/i.test(f.name)) {
      list.innerHTML = '';
      err.textContent = `${f.name} is already comma-separated. This page converts tab-separated files.`;
      err.hidden = false;
      return;
    }
    if (fromCsvTsv && /\.tsv$/i.test(f.name)) {
      list.innerHTML = '';
      err.textContent = `${f.name} is already tab-separated. This page converts comma-separated files.`;
      err.hidden = false;
      return;
    }
    name = baseName(f.name);
    list.innerHTML = '';
    const li = document.createElement('li');
    li.innerHTML = '<span class="name"></span>';
    li.querySelector('.name')!.textContent = f.name;
    list.append(li);
    if (fromXlsx) {
      try {
        const { xlsxToCsv } = await import('../lib/xlsx');
        const wb = xlsxToCsv(new Uint8Array(await f.arrayBuffer()));
        input.value = wb.csv;
        sheetInfo = wb.sheets.length > 1 ? `Converted the first of ${wb.sheets.length} sheets (${wb.sheets[0]}).` : '';
      } catch (e) {
        input.value = '';
        sheetInfo = '';
        update();
        err.textContent = (e as Error).message;
        err.hidden = false;
        return;
      }
    } else {
      input.value = await f.text();
    }
    // The file is loaded: shrink the drop zone and fold the raw text away so Download sits right under the settings.
    drop.classList.add('compact');
    $('pasteWrap')!.hidden = true;
    $('showText')!.hidden = false;
    update();
    if (all.length > 1 && err.hidden) { err.textContent = `One file at a time here, so I used ${f.name} and left ${all.length - 1} out.`; err.hidden = false; }
  });
  $('showText')!.addEventListener('click', () => {
    $('pasteWrap')!.hidden = false;
    $('showText')!.hidden = true;
    input.focus();
  });

  const done = (blob: Blob, file: string) => {
    save(blob, file);
    showDone({
      el: $('done')!, slug: root.dataset.slug!, line: savedLine(file), again: () => save(blob, file),
      result: new File([blob], file, { type: blob.type }),
      reset: () => {
        input.value = ''; list.innerHTML = ''; name = 'data'; sheetInfo = '';
        drop.classList.remove('compact'); $('pasteWrap')!.hidden = fromXlsx; $('showText')!.hidden = true;
        update();
      },
    });
  };
  go.addEventListener('click', async () => {
    if (tool === 'csv-to-json' || tool === 'xlsx-to-json' || tool === 'md-to-json' || tool === 'yaml-to-json') done(new Blob([result], { type: 'application/json' }), `${name}.json`);
    else if (tool === 'json-to-yaml') done(new Blob([result], { type: 'application/yaml' }), `${name}.yaml`);
    else if (fromCsvTsv || tool === 'xlsx-to-tsv') done(new Blob(['﻿' + result], { type: 'text/tab-separated-values' }), `${name}.tsv`); // BOM so Excel reads UTF-8
    else if (tool === 'csv-to-markdown' || tool === 'xlsx-to-markdown' || tool === 'json-to-markdown') done(new Blob([result], { type: 'text/markdown' }), `${name}.md`);
    else if (tool === 'json-to-csv' || fromXlsx || fromTsv || tool === 'md-to-csv') done(new Blob(['﻿' + result], { type: 'text/csv' }), `${name}.csv`); // BOM so Excel reads UTF-8
    else {
      go.disabled = true;
      status.textContent = 'Building workbook…';
      try {
        const { csvToXlsx } = await import('../lib/xlsx');
        // For JSON and Markdown the workbook is built from the CSV the preview made, not from the raw text.
        const bytes = tool === 'json-to-xlsx' || tool === 'md-to-xlsx'
          ? csvToXlsx(result, { delimiter: ',', header: true, typed: true, sheetName: name })
          : csvToXlsx(input.value, { ...opts(), sheetName: name });
        status.textContent = '';
        done(new Blob([bytes as BlobPart], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }), `${name}.xlsx`);
      } catch (e) {
        err.textContent = (e as Error).message; err.hidden = false;
      } finally { go.disabled = false; }
    }
  });

  copy?.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(result); copy.textContent = 'Copied'; setTimeout(() => (copy.textContent = 'Copy'), 1500); }
    catch { err.textContent = 'Your browser blocked copying. Use the download instead.'; err.hidden = false; }
  });
</script>
