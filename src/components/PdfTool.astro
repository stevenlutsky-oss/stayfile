---
import Drop from './Drop.astro';
import type { Tool, Preset } from '../site';
import { splitButtons } from '../lib/route';
interface Props { tool: Tool; preset?: Preset; slug: string }
const { tool, preset = {}, slug } = Astro.props;
const multi = tool === 'pdf-merge' || tool === 'img-to-pdf';
const isImg = tool === 'img-to-pdf';
const isTxt = tool === 'text-to-pdf';
const accept = isTxt ? (preset.accept ?? '.txt,.md,.log,.markdown,text/plain') : isImg ? (preset.accept ?? 'image/*,.jpg,.jpeg,.png,.webp,.gif,.avif,.heic,.heif,.bmp,.svg') : 'application/pdf,.pdf';
const main = isTxt ? (preset.accept ? 'Drop a Markdown file here, or <u>choose one</u>' : 'Drop a text file here, or <u>choose one</u>') : multi ? `Drop ${isImg ? 'images' : 'PDF files'} here, or <u>choose files</u>` : 'Drop a PDF here, or <u>choose one</u>';
const sub = isTxt ? (preset.accept ? '.md and .markdown files' : 'Plain text, Markdown or log files') : isImg ? 'JPG · PNG · WebP · GIF · SVG' : multi ? 'Add as many as you like' : 'One PDF';
const split = preset.split ?? 'ranges';
// Rotate and split: each choice is its own button that does the job, so there is no pick-then-confirm step.
const runs = tool === 'pdf-rotate'
  ? [{ v: '90', l: '↻ Turn right' }, { v: '270', l: '↺ Turn left' }, { v: '180', l: 'Turn upside down' }]
  : tool === 'pdf-split'
    ? splitButtons(split)
    : [];
const action = { 'pdf-merge': 'Merge PDFs', 'pdf-split': split === 'extract' ? 'Extract pages' : split === 'remove' ? 'Remove pages' : 'Split PDF', 'pdf-rotate': 'Rotate and save', 'img-to-pdf': 'Make PDF', 'pdf-to-jpg': 'Convert to JPG', 'pdf-to-png': 'Convert to PNG', 'pdf-to-text': 'Extract text', 'text-to-pdf': 'Make PDF' }[tool as string];
---
<section class="tool" data-tool={tool} data-split={split} data-slug={slug}>
  <ul class="files" id="list"></ul>
  <div class="thumbs" id="thumbs" hidden role="group" aria-label="Page previews"></div>
  <Drop accept={accept} multiple={multi} main={main} sub={sub} />

  <div id="work" hidden>
    {tool === 'pdf-split' && (
      <div class="opts">
        <label class="full" id="rangeWrap">Pages
          <input id="ranges" placeholder="e.g. 1-3, 5, 8-" autocomplete="off" />
        </label>
        <p class="hint" id="splitHint"></p>
      </div>
    )}
    {tool === 'pdf-rotate' && (
      <div class="opts">
        <label>Pages <input id="ranges" placeholder="All pages" autocomplete="off" /></label>
        <p class="hint">Leave pages empty to turn every page, or type some, like 2, 4-6.</p>
      </div>
    )}
    {(tool === 'pdf-to-jpg' || tool === 'pdf-to-png') && (
      <div class="opts">
        <label>Resolution
          <select id="dpi">
            <option value="96">Screen (96 dpi)</option>
            <option value="150" selected>Good (150 dpi)</option>
            <option value="300">Print (300 dpi)</option>
          </select>
        </label>
        <p class="hint">Higher numbers make sharper pages and bigger files. Every page becomes its own {tool === 'pdf-to-png' ? 'PNG' : 'JPG'}.</p>
      </div>
    )}
    {tool === 'pdf-to-text' && (
      <div class="opts">
        <textarea id="textOut" rows="12" readonly spellcheck="false" hidden aria-label="Extracted text"></textarea>
      </div>
    )}
    {isImg && (
      <div class="opts">
        <label>Page size
          <select id="size">
            <option value="fit">Same as image</option>
            <option value="a4">A4</option>
            <option value="letter">US Letter</option>
          </select>
        </label>
        <label id="marginWrap" hidden>Margin
          <select id="margin">
            <option value="0">None</option>
            <option value="18">Small</option>
            <option value="36" selected>Medium</option>
            <option value="72">Large</option>
          </select>
        </label>
      </div>
    )}
    <div class="actions">
      {runs.length
        ? runs.map((r, i) => <button type="button" class={i === 0 ? 'primary' : 'secondary'} data-run={r.v}>{r.l}</button>)
        : <button type="button" class="primary" id="go" data-run="">{action}</button>}
      <button type="button" class="link" id="reset">Start over</button>
      <span class="status" id="status" aria-live="polite"></span>
    </div>
  </div>
  <div class="done" id="done" role="status" hidden></div>
  <p class="error" id="err" role="alert" hidden></p>
</section>

<script>
  // pdf-lib is about half a megabyte, so it loads when a PDF is dropped, not when the page opens.
  import type { ImageInput, PageSize } from '../lib/pdf';
  const pdfLib = () => import('../lib/pdf');
  import { decode, draw, formatBytes } from '../lib/image';
  import { save, zip, baseName } from '../lib/save';
  import { mergedName, savedLine } from '../lib/route';
  import { showDone, hideDone } from '../lib/done';

  const root = document.querySelector<HTMLElement>('.tool')!;
  const tool = root.dataset.tool!;
  const multi = tool === 'pdf-merge' || tool === 'img-to-pdf';
  const isImg = tool === 'img-to-pdf';
  const isTxt = tool === 'text-to-pdf';
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const list = $('list')!, drop = $('drop')!, work = $('work')!, runBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-run]')];
  const status = $('status')!, err = $('err')!;
  const ranges = $<HTMLInputElement>('ranges');

  // Page previews. pdf.js is loaded the first time a PDF is dropped, not when the page opens.
  const thumbs = $('thumbs')!;
  const previews = tool !== 'pdf-merge' && !isImg && !isTxt;
  const canInsert = tool === 'pdf-rotate' || tool === 'pdf-split'; // tools with a pages box
  let thumbRun = 0;
  function clearThumbs() { thumbRun++; thumbs.innerHTML = ''; thumbs.hidden = true; }
  function insertPage(n: number) {
    if (!ranges) return;
    const v = ranges.value.trim();
    ranges.value = v ? `${v}, ${n}` : String(n);
    ranges.focus();
  }
  async function showThumbs(file: File) {
    if (!previews) return;
    const run = ++thumbRun;
    thumbs.hidden = false;
    thumbs.innerHTML = '<span class="busy">Drawing page previews…</span>';
    try {
      const bytes = new Uint8Array(await file.arrayBuffer());
      const { pdfThumbnails } = await import('../lib/pdf-render');
      const { pages, total } = await pdfThumbnails(bytes);
      if (run !== thumbRun) return; // a newer file replaced this one
      thumbs.innerHTML = '';
      pages.forEach((src, i) => {
        const n = i + 1;
        const clickable = canInsert && mode() !== 'every';
        const cell = document.createElement(clickable ? 'button' : 'div');
        cell.className = 'pt';
        if (cell instanceof HTMLButtonElement) {
          cell.type = 'button';
          cell.title = `Add page ${n} to the pages box`;
          cell.setAttribute('aria-label', `Add page ${n} to the pages box`);
          cell.addEventListener('click', () => insertPage(n));
        }
        const img = document.createElement('img');
        img.src = src; img.alt = ''; img.width = 84;
        const num = document.createElement('span');
        num.textContent = String(n);
        cell.append(img, num);
        thumbs.append(cell);
      });
      if (total > pages.length) {
        const note = document.createElement('span');
        note.className = 'note';
        note.textContent = `First ${pages.length} of ${total} pages shown.`;
        thumbs.append(note);
      }
    } catch {
      if (run === thumbRun) clearThumbs(); // previews are a nicety, never block the tool
    }
  }

  type Item = { file: File; pages?: number; url?: string };
  let items: Item[] = [];

  const fail = (m: string) => { err.textContent = m; err.hidden = false; status.textContent = ''; };
  const clear = () => { err.hidden = true; };

  function render() {
    hideDone($('done'));
    list.innerHTML = '';
    items.forEach((it, i) => {
      const li = document.createElement('li');
      if (multi) li.innerHTML = `<span class="n">${i + 1}</span>`;
      if (it.url) {
        const img = document.createElement('img');
        img.className = 'thumb'; img.src = it.url; img.alt = '';
        li.append(img);
      }
      const name = document.createElement('span');
      name.className = 'name'; name.textContent = it.file.name;
      const meta = document.createElement('span');
      meta.className = 'meta';
      meta.textContent = [it.pages != null ? `${it.pages} page${it.pages === 1 ? '' : 's'}` : '', formatBytes(it.file.size)].filter(Boolean).join(' · ');
      li.append(name, meta);
      if (multi) {
        const mk = (label: string, title: string, fn: () => void, disabled = false) => {
          const b = document.createElement('button');
          b.type = 'button'; b.className = 'icon'; b.textContent = label; b.title = title; b.setAttribute('aria-label', `${title}: ${it.file.name}`);
          b.disabled = disabled; b.onclick = fn; return b;
        };
        li.append(
          mk('↑', 'Move up', () => { [items[i - 1], items[i]] = [items[i], items[i - 1]]; render(); }, i === 0),
          mk('↓', 'Move down', () => { [items[i + 1], items[i]] = [items[i], items[i + 1]]; render(); }, i === items.length - 1),
          mk('✕', 'Remove', () => { if (it.url) URL.revokeObjectURL(it.url); items.splice(i, 1); render(); }),
        );
      }
      list.append(li);
    });
    work.hidden = !items.length;
    if (tool === 'pdf-to-text') { const out = $<HTMLTextAreaElement>('textOut'); if (out) { out.hidden = true; out.value = ''; } }
    drop.classList.toggle('compact', items.length > 0);
    drop.hidden = !multi && items.length > 0;
    const need = tool === 'pdf-merge' ? 2 : 1;
    runBtns.forEach((b) => (b.disabled = items.length < need));
    if (tool === 'pdf-merge' && items.length === 1) status.textContent = 'Add at least one more PDF.';
    else if (!status.dataset.busy) status.textContent = '';
    updateHint();
  }

  async function add(files: File[]) {
    clear();
    for (const file of files) {
      if (isImg) {
        if (!file.type.startsWith('image/') && !/\.(jpe?g|png|webp|gif|avif|bmp|svg|heic|heif)$/i.test(file.name)) { fail(`${file.name} is not an image.`); continue; }
        items.push({ file, url: URL.createObjectURL(file) });
      } else if (isTxt) {
        const looksText = /^text\//.test(file.type) || file.type === 'application/markdown' || file.type === '' || /\.(txt|md|log|markdown)$/i.test(file.name);
        if (!looksText) { fail(`${file.name} is not a text file.`); continue; }
        items.push({ file });
      } else {
        try {
          const { pageCount } = await pdfLib();
          const pages = await pageCount(await file.arrayBuffer());
          items.push({ file, pages });
        } catch (e) {
          fail(`${file.name}: ${(e as Error).message.includes('password') ? (e as Error).message : 'this does not look like a PDF, or it is damaged.'}`);
        }
      }
      if (!multi) items = items.slice(-1);
    }
    if (!multi) {
      const first = items[items.length - 1];
      if (first && !isImg && !isTxt) showThumbs(first.file); else clearThumbs();
      if (files.length > 1 && first && err.hidden) {
        err.textContent = `One file at a time here, so I kept ${first.file.name}.`;
        err.hidden = false;
      }
    }
    render();
  }
  drop.addEventListener('files', (e) => add((e as CustomEvent<File[]>).detail));

  $('reset')!.addEventListener('click', () => { items.forEach((i) => i.url && URL.revokeObjectURL(i.url)); items = []; clear(); clearThumbs(); render(); });

  // Which button was pressed: a split mode or a rotation in degrees.
  let choice = '';
  const mode = () => choice || 'ranges';
  function updateHint() {
    if (tool !== 'pdf-split') return;
    if (root.dataset.split === 'remove') { $('splitHint')!.textContent = 'Type the pages to take out, like 2, 5-7. Every other page is saved in one new PDF.'; return; }
    const n = items[0]?.pages;
    $('splitHint')!.textContent = `Type pages like 1-3, 7, then save them as one PDF or each range as its own file.${n && n > 1 ? ` Every page a file gives ${n} one-page PDFs in a zip.` : ''}`;
  }
  $('size')?.addEventListener('change', () => ($('marginWrap')!.hidden = $<HTMLSelectElement>('size')!.value === 'fit'));

  // PDF can hold JPG and PNG directly. Anything else is redrawn and saved as a high-quality JPG.
  async function asPdfImage(f: File): Promise<ImageInput> {
    const bytes = new Uint8Array(await f.arrayBuffer());
    const isJpg = bytes[0] === 0xff && bytes[1] === 0xd8;
    const isPng = bytes[0] === 0x89 && bytes[1] === 0x50;
    if (isJpg) return { bytes, type: 'image/jpeg' };
    if (isPng) return { bytes, type: 'image/png' };
    const bmp = await decode(f, true);
    const c = draw(bmp, bmp.width, bmp.height, true);
    bmp.close();
    const blob: Blob = await new Promise((r, j) => c.toBlob((b) => (b ? r(b) : j(new Error('Could not convert image.'))), 'image/jpeg', 0.92));
    return { bytes: new Uint8Array(await blob.arrayBuffer()), type: 'image/jpeg' };
  }

  // Every save goes through here so the done panel can offer it again and pass it on.
  let last: { data: Uint8Array; name: string; type: string; count: number } | null = null;
  const put = (data: Uint8Array, name: string, type: string, count = 1) => { last = { data, name, type, count }; save(data, name, type); };

  runBtns.forEach((b) => b.addEventListener('click', () => run(b.dataset.run!)));
  async function run(pressed: string) {
    choice = pressed;
    clear();
    hideDone($('done'));
    last = null;
    runBtns.forEach((b) => (b.disabled = true));
    status.dataset.busy = '1';
    status.textContent = 'Working…';
    const t0 = performance.now();
    try {
      const first = items[0];
      const name = baseName(first.file.name);
      const pdf = 'application/pdf';
      let done = '';
      const { parseRanges, pagesToKeep, merge, extract, split, burst, rotate, imagesToPdf, pageImageName, textToPdf } = await pdfLib();
      if (tool === 'pdf-merge') {
        const out = await merge(await Promise.all(items.map((i) => i.file.arrayBuffer())));
        put(out, mergedName(first.file.name), pdf);
        done = `Merged ${items.length} files, ${items.reduce((a, i) => a + (i.pages ?? 0), 0)} pages.`;
      } else if (tool === 'pdf-rotate') {
        const by = +choice || 90;
        const sel = ranges!.value.trim() ? parseRanges(ranges!.value, first.pages!).flat() : undefined;
        put(await rotate(await first.file.arrayBuffer(), by, sel), `${name}-rotated.pdf`, pdf);
        done = `Rotated ${sel ? sel.length : first.pages} page${(sel ? sel.length : first.pages) === 1 ? '' : 's'}.`;
      } else if (tool === 'pdf-split') {
        const buf = await first.file.arrayBuffer();
        const m = mode();
        if (m === 'extract') {
          const pages = parseRanges(ranges!.value, first.pages!).flat();
          put(await extract(buf, pages), `${name}-pages.pdf`, pdf);
          done = `Saved ${pages.length} page${pages.length === 1 ? '' : 's'} as a new PDF.`;
        } else if (m === 'remove') {
          const drop = parseRanges(ranges!.value, first.pages!).flat();
          const keep = pagesToKeep(drop, first.pages!);
          if (!keep.length) throw new Error('That would remove every page. Leave at least one page.');
          put(await extract(buf, keep), `${name}-removed.pdf`, pdf);
          const removed = new Set(drop).size;
          done = `Removed ${removed} page${removed === 1 ? '' : 's'}. The new PDF has ${keep.length}.`;
        } else {
          const groups = m === 'every' ? null : parseRanges(ranges!.value, first.pages!);
          const parts = groups ? await split(buf, groups) : await burst(buf);
          const label = (i: number) => {
            if (!groups) return `${name}-page-${String(i + 1).padStart(String(parts.length).length, '0')}.pdf`;
            const g = groups[i];
            return `${name}-p${g[0] + 1}${g.length > 1 ? `-${g[g.length - 1] + 1}` : ''}.pdf`;
          };
          if (parts.length === 1) put(parts[0], label(0), pdf);
          else put(await zip(parts.map((d, i) => ({ name: label(i), data: d }))), `${name}-split.zip`, 'application/zip', parts.length);
          done = `Made ${parts.length} PDF${parts.length === 1 ? '' : 's'}.`;
        }
      } else if (tool === 'pdf-to-jpg' || tool === 'pdf-to-png') {
        const format = tool === 'pdf-to-png' ? 'png' : 'jpg';
        const dpi = +$<HTMLSelectElement>('dpi')!.value;
        const { pdfToImages } = await import('../lib/pdf-render'); // pdf.js loads only on this page, when it runs
        const pages = await pdfToImages(new Uint8Array(await first.file.arrayBuffer()), dpi, format, (i, n) => {
          status.textContent = `Drawing page ${i} of ${n}…`;
        });
        const n = pages.length;
        const mime = format === 'png' ? 'image/png' : 'image/jpeg';
        if (n === 1) put(pages[0], `${name}.${format}`, mime);
        else put(await zip(pages.map((d, i) => ({ name: pageImageName(name, i + 1, n, format), data: d }))), `${name}-${format}.zip`, 'application/zip', n);
        done = `Made ${n} ${format.toUpperCase()}${n === 1 ? '' : 's'} at ${dpi} dpi.`;
      } else if (tool === 'pdf-to-text') {
        const { pdfToText } = await import('../lib/pdf-render'); // pdf.js loads only on this page, when it runs
        const result = await pdfToText(new Uint8Array(await first.file.arrayBuffer()));
        if (result.empty) throw new Error('No text found. The PDF was probably made by scanning pages to images, so there is no text to extract.');
        const out = $<HTMLTextAreaElement>('textOut')!;
        out.value = result.text.length > 200_000 ? result.text.slice(0, 200_000) + '\n… (preview cut short; the download has everything)' : result.text;
        out.hidden = false;
        put(new TextEncoder().encode(result.text), `${name}.txt`, 'text/plain');
        done = `Extracted text from ${result.pages} page${result.pages === 1 ? '' : 's'}.`;
      } else if (isTxt) {
        const text = await first.file.text();
        if (!text.trim()) throw new Error('That file is empty.');
        put(await textToPdf(text), `${name}.pdf`, pdf);
        done = 'Made a PDF from the text.';
      } else if (isImg) {
        const size =($<HTMLSelectElement>('size')!.value) as PageSize;
        const margin = +$<HTMLSelectElement>('margin')!.value;
        const imgs: ImageInput[] = [];
        for (const [i, it] of items.entries()) {
          status.textContent = `Reading image ${i + 1} of ${items.length}…`;
          imgs.push(await asPdfImage(it.file));
        }
        status.textContent = 'Building PDF…';
        const out = await imagesToPdf(imgs, size, size === 'fit' ? 0 : margin);
        put(out, items.length === 1 ? `${name}.pdf` : `${name}-and-${items.length - 1}-more.pdf`, pdf);
        done = `Made a ${items.length}-page PDF (${formatBytes(out.length)}).`;
      }
      const secs = (performance.now() - t0) / 1000;
      status.textContent = '';
      const got = last as typeof last;
      if (got) {
        showDone({
          el: $('done')!,
          slug: root.dataset.slug!,
          line: `${done}${secs >= 0.5 ? ` Took ${secs.toFixed(1)} s.` : ''} ${savedLine(got.name, got.count)}`,
          again: () => save(got.data, got.name, got.type),
          result: got.count === 1 ? new File([got.data as BlobPart], got.name, { type: got.type }) : undefined
        });
      }
    } catch (e) {
      fail((e as Error).message || 'Something went wrong with this file.');
    } finally {
      delete status.dataset.busy;
      runBtns.forEach((b) => (b.disabled = false));
    }
  }
</script>
